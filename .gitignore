# Tooling
.pytest_cache/
*.egg-info/
build/
dist/
*.fab

# Secrets and cluster credentials (never commit)
.env
.env.*
*.kubeconfig
kubeconfig*
.kube/

# Model checkpoints outside results/ (results/ is ignored above)
*.pt
*.joblib

# OS / editor noise
.DS_Store
